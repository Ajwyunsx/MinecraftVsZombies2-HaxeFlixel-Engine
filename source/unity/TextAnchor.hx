package unity;

// Minimal UnityEngine.TextAnchor shim.
enum abstract TextAnchor(Int) {
    var UpperLeft = 0;
    var UpperCenter = 1;
    var UpperRight = 2;
    var MiddleLeft = 3;
    var MiddleCenter = 4;
    var MiddleRight = 5;
    var LowerLeft = 6;
    var LowerCenter = 7;
    var LowerRight = 8;
}
